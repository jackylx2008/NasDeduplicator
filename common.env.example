# Copy to common.env and set the local NAS root for your operating system.
LOCAL_NAS_WINDOWS=
LOCAL_NAS_MACOS=

# Optional overrides
# NAS_ROOT=
# NAS_DEDUPLICATOR_DB=
# LOG_LEVEL=INFO

# Non-secret collaboration endpoint shown in the HTML audit panel.
NAS_DEDUP_DB_HOST=192.168.1.192
NAS_DEDUP_DB_PORT=15432
NAS_DEDUP_DSM_URL=http://192.168.1.192:5000/
NAS_DEDUP_PG_DATA_DIR=/volume2/docker/nas-deduplicator-postgres
